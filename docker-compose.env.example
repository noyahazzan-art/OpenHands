# Copy to ".env" in the same directory as docker-compose.yml for variable substitution.
# See: https://docs.docker.com/compose/environment-variables/set-environment-variables/
#
# Windows: validate engine and bring the stack up (optional -StartDesktop if Docker is off):
#   powershell -ExecutionPolicy Bypass -File scripts/docker-up.ps1 -StartDesktop
#   scripts\docker-up.cmd -StartDesktop
# Dry-run (compose validation only):
#   powershell -ExecutionPolicy Bypass -File scripts/docker-up.ps1 -DryRun
# Rebuild images on up:
#   powershell -ExecutionPolicy Bypass -File scripts/docker-up.ps1 -StartDesktop -Build

# Ollama / LiteLLM (defaults match docker-compose.yml)
LLM_MODEL=ollama/qwen2.5-coder:14b
LLM_API_KEY=ollama
LLM_PROVIDER=ollama

# Ollama reachable from inside the OpenHands container.
# - Docker Desktop (Windows/macOS): host.docker.internal
# - Linux host: often http://172.17.0.1:11434 or your LAN IP
# LLM_BASE_URL=http://10.0.0.7:11434

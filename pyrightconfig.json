{
  "include": ["openhands", "tests", "scripts", "skills"],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "**/.git",
    "**/.venv",
    "**/.*",
    "**/.mypy_cache",
    "**/.pytest_cache",
    "**/.ruff_cache",
    "**/evaluation",
    "**/frontend",
    "**/third_party",
    "**/containers",
    "**/kind",
    "**/enterprise",
    "**/openhands-ui",
    "**/openhands-cli",
    "**/.devcontainer",
    "**/.github",
    "**/.openhands",
    "**/.mcpower",
    "**/.cursor",
    "**/dev_config",
    "**/logs",
    "**/workspace",
    "**/output",
    "**/test-results",
    "**/.sessions",
    "**/.eval_sessions"
  ],
  "pythonVersion": "3.12",
  "typeCheckingMode": "standard",
  "reportMissingImports": "warning",
  "reportMissingTypeStubs": "none"
}
